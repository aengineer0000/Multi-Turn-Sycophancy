# Copy this file to .env and fill only the values you need.
# NEVER commit .env or real API keys.

# Needed only if you run score_behavior.py with --use-llm-judge
GOOGLE_API_KEY=replace_me
JUDGE_MODEL=gemini-3.1-flash-lite

# Optional. Usually `hf auth login` is easier than putting a token here.
HF_TOKEN=replace_me_if_needed
